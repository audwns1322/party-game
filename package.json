{
  "name": "party-game",
  "version": "0.0.0",
  "description": "실시간 멀티플레이 파티 게임 플랫폼 — M0 개발 기반 및 보안 POC",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "db:start": "SUPABASE_HOME=${SUPABASE_HOME:-$PWD/.cache/supabase} SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start",
    "db:reset": "SUPABASE_HOME=${SUPABASE_HOME:-$PWD/.cache/supabase} SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase db reset",
    "test:db": "SUPABASE_HOME=${SUPABASE_HOME:-$PWD/.cache/supabase} supabase test db",
    "test:integration": "node --test tests/integration/m0.mjs",
    "functions:serve": "SUPABASE_HOME=${SUPABASE_HOME:-$PWD/.cache/supabase} SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase functions serve m0-snapshot",
    "test:sql": "vitest run tests/integration/db.test.ts",
    "typecheck:edge": "DENO_DIR=.cache/deno deno check --node-modules-dir=manual supabase/functions/m0-snapshot/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audwns1322/party-game.git"
  },
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "deno": "2.9.6",
    "eslint": "10.13.0",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
