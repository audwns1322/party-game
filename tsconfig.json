{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "tests/unit",
    "supabase/functions/_shared",
    "vite.config.ts",
    "tests/integration/db.test.ts",
    "tests/integration/room.test.ts",
    "tests/integration/game.test.ts"
  ],
  "exclude": [
    "supabase/functions/_shared/server.ts"
  ]
}
